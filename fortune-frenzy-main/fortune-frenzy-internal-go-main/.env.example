# Go API
PORT=3004

# MariaDB
MARIADB_HOST=mariadb
MARIADB_USER=fortunefrenzy
MARIADB_PASSWORD=CHANGE_ME_TO_RANDOM_STRING
MARIADB_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_RANDOM_STRING

# MongoDB (wallet: cash offline/online). If MONGODB_URI is unset, wallet uses MariaDB cash_changes + listing fallback.
# Atlas: Database Access = DB username + password; give that user built-in role readWrite on MONGODB_DATABASE (e.g. fortune_frenzy).
# Network Access = your API server’s public IP.
# URL-encode special characters in the password (e.g. @ → %40).
# In a real .env file, wrap the whole URI in single quotes — query string uses & and bash would otherwise
# treat & as "run in background" when you `source .env`, truncating MONGODB_URI.
# MONGODB_URI='mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster1'
# MONGODB_DATABASE=fortune_frenzy

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_RANDOM_STRING

# Rate limits (fixed 1-minute Redis windows). Set to 0 to disable that tier. Keys: server-id header, or IP for /register.
# Sub-requests using PACKETER_BYPASS_KEY or internal-auth headers are not counted.
# RL_READ_PER_MIN=2000
# RL_WRITE_PER_MIN=320
# RL_STRICT_PER_MIN=55
# RL_PACKET_PER_MIN=720
# RL_REGISTER_PER_MIN=40

# Security
MASTER_KEY=CHANGE_ME_TO_64_CHAR_RANDOM_STRING
PACKETER_BYPASS_KEY=CHANGE_ME_TO_RANDOM_STRING
SERVER_RANDOMNESS_SEED=CHANGE_ME_TO_RANDOM_STRING

# Domain (used by Caddy)
DOMAIN=api.yourdomain.xyz

# Discord webhook for logging API activity and errors
DISCORD_WEBHOOK_URL=

# Optional: override default house user (10806687448) for coinflip bot wins; that user is hidden from leaderboards
# COINFLIP_BOT_WIN_USER_ID=

# Optional: cap internal self-HTTP calls (coinflip start chain, etc.) in seconds (default 120)
# INTERNAL_HTTP_TIMEOUT_SEC=120

# Case open price = ceil(EV * (1 + percent/100)); EV from item values × odds. Default 5 if unset.
# CASE_OPEN_HOUSE_EDGE_PERCENT=5

# Seconds to wait after API start before first Rolimons→MariaDB merge (reduces lock contention with /cases, /marketplace/items). Default 8.
# ROLIMONS_INITIAL_DELAY_SEC=8

# Debug: log payloads returned to Roblox (POST /packet/:serverId). Values: off | summary | full | both
# LOG_ROBLOX_OUTBOUND=both
# LOG_ROBLOX_OUTBOUND_MAX_BYTES=2097152
