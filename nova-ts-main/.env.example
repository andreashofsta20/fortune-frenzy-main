# Discord bot (create at https://discord.com/developers/applications — never commit the real token)
DISCORD_TOKEN=

# If you see "Used disallowed intents": Portal → Bot → enable Server Members + Message Content, save, restart.
# Temporary bypass (some features off): DISCORD_SKIP_PRIVILEGED_INTENTS=true

# Optional: staff **role** id (members with this role get staff commands). Owner user ids are in src/config/discord-ids.ts
# DISCORD_STAFF_ROLE_ID=

# Role id added when Roblox group_rank > 3 (must be a real role in the server; not your user id)
# DISCORD_GAME_RANK_STAFF_ROLE_ID=

# When true, subscribes to Redis and forwards Fortune Frenzy API logs to the webhook below.
FORTUNE_FRENZY_API_LOGS_ENABLED=false
# Webhook URL for messages relayed from the API (can match DISCORD_WEBHOOK_URL on the Go API if you only want one channel)
FORTUNE_FRENZY_LOG_WEBHOOK_URL=

# Redis (same as fortune-frenzy-internal-go-main: use the same host/password as api.fortunefrenzy.xyz)
# Docker: attach bot to the API compose network and use the Redis *service* hostname:
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Must match Go when using relay (default api_discord_log)
FF_API_LOG_REDIS_CHANNEL=api_discord_log

# Fortune Frenzy API (fortune-frenzy-internal-go) — for /ffplayer, /ffleaderboard, /ffwipe, etc.
# Base URL (alias: FF_API_URL):
# - Bot on the HOST (node/npm, not Docker): http://127.0.0.1:3004
# - Bot in Docker (see nova-ts-main/docker-compose.yml): use http://ff-api:3004 — compose sets this; do NOT use 127.0.0.1 in .env for Docker (localhost is the container itself).
# FORTUNE_FRENZY_API_BASE_URL=http://127.0.0.1:3004
#
# If only certain IPs may reach your *public* API URL, the bot must connect from an allowed IP **or** use a
# private path that bypasses that rule: e.g. same host `http://127.0.0.1:3004`, or Docker network `http://ff-api:3004`
# so traffic stays on the server/VPC. Whitelist the bot VPS egress IP if you must use the public hostname.
#
# Auth (pick one):
# (A) EASIEST — copy this line from fortune-frenzy-internal-go-main/.env (identical value):
PACKETER_BYPASS_KEY=
# (B) Game server keys stored in Redis — must match a registered game server:
# FORTUNE_FRENZY_SERVER_ID=
# FORTUNE_FRENZY_API_KEY=
# Aliases for (B): FF_SERVER_ID + FF_API_KEY
# Alternative name for (A): FORTUNE_FRENZY_PACKETER_BYPASS_KEY=

# Optional: Fortune Frenzy slash embed branding (HTTPS URLs only; Discord rejects http)
# FF_EMBED_ICON_URL=https://…   # small circle next to author name (all branded embeds)
# FF_EMBED_BANNER_URL=https://… # wide image under fields on /ffcommands, /ffleaderboard (and /ffplayer if below is true)
# FF_EMBED_BANNER_ON_PLAYER=true

# Optional: override /fflinks game URL (default is production Fortune Frenzy on Roblox)
# FF_LINK_GAME=https://www.roblox.com/games/138955851313890/Fortune-Frenzy

# --- Optional: Novaware-only MariaDB (verify button, levelling /rank, /fingerprint_info, support tickets, /regenCases, etc.)
# You do NOT need this for Fortune Frenzy: /ffplayer, /ffleaderboard, API log relay, and Redis use the blocks above.
# Leave all of these unset if you only run FF + Discord.
# DISCORD_MARIADB_HOST=proxysql
# DISCORD_MARIADB_PORT=6033
# DISCORD_MARIADB_USER=
# DISCORD_MARIADB_PASSWORD=
# GAME1_MARIADB_USER=
# GAME1_MARIADB_PASSWORD=
